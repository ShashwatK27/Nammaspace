# Dependencies
node_modules/
viewer/dist/
.dist/

# Reconstruction I/O (large binaries — keep out of git)
data/raw/
data/processed/
output/scenes/**/splat/
output/scenes/**/mesh/
output/scenes/**/cloud/
*.ply
*.splat
*.ksplat
*.glb
*.gltf
!viewer/public/**/*.glb

# COLMAP / pipeline artifacts
*.db
sparse/
dense/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Python (reconstruction pipeline)
__pycache__/
*.pyc
.venv/
venv/

# Brush/burn autotune cache (written to cwd)
target/

# Web-ready compressed splats ARE tracked (small, deploy artifacts); raw .ply/.splat stay ignored
!viewer/public/scenes/**/*.ksplat
reconstruction/assets/*.bin

# Generated scene bundles (regenerated by the pipeline)
output/

# Local-only drafts, screenshot tooling, and one-off configs (not for submission)
docs/*.pdf
docs/technical-abstract.md
docs/round1-findings.md
viewer/shot*.mjs
reconstruction/config/pipeline_lr.json
reconstruction/config/pipeline_full.json
